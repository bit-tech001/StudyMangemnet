rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    
    // Check if user is a teacher
    function isTeacher() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (isOwner(userId) || isTeacher());
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'department', 'studentId'])
      );
      
      function isValidUser(data) {
        return data.uid == request.auth.uid &&
               data.email is string && data.email.size() <= 200 &&
               data.role in ['teacher', 'student'] &&
               data.fullName is string && data.fullName.size() <= 100;
      }
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() && isValidAssignment(incoming());
      allow update: if isTeacher() && isOwner(existing().teacherId) && isValidAssignment(incoming());
      allow delete: if isTeacher() && isOwner(existing().teacherId);

      function isValidAssignment(data) {
        return data.teacherId == request.auth.uid &&
               data.title is string && data.title.size() <= 200 &&
               data.courseName is string && data.courseName.size() <= 100;
      }
    }

    match /exams/{examId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() && isValidExam(incoming());
      allow update: if isTeacher() && isOwner(existing().teacherId) && isValidExam(incoming());
      allow delete: if isTeacher() && isOwner(existing().teacherId);

      function isValidExam(data) {
        return data.teacherId == request.auth.uid &&
               data.title is string && data.title.size() <= 200 &&
               data.status in ['scheduled', 'active', 'completed'];
      }
    }

    match /submissions/{submissionId} {
      allow get: if isSignedIn() && (isOwner(existing().studentId) || isTeacher());
      allow list: if isSignedIn() && (isOwner(resource.data.studentId) || isTeacher());
      allow create: if isSignedIn() && isOwner(incoming().studentId) && isValidSubmission(incoming());
      allow update: if (isTeacher() && incoming().diff(existing()).affectedKeys().hasOnly(['marksObtained', 'feedback', 'isGraded']));

      function isValidSubmission(data) {
        return data.studentId == request.auth.uid &&
               data.type in ['assignment', 'exam'] &&
               data.taskId is string;
      }
    }
  }
}
